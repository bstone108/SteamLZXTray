<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>SteamLZXTray</RootNamespace>
    <AssemblyName>SteamLZXTray</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Version: pass -p:AppVersion=YYYY.MM.DD.BB (CI derives it from the tag); otherwise read ../VERSION.txt. -->
    <AppVersion Condition="'$(AppVersion)' == '' and Exists('$(MSBuildThisFileDirectory)..\VERSION.txt')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION.txt').Trim())</AppVersion>
    <AppVersion Condition="'$(AppVersion)' == ''">0.0.0.0</AppVersion>
    <!-- Numeric form for Win32 file version (each part <= 65535, leading zeros dropped): 2026.11.26.01 -> 2026.11.26.1 -->
    <AppNumericVersion>$([System.Version]::Parse('$(AppVersion)').ToString())</AppNumericVersion>
    <Version>$(AppNumericVersion)</Version>
    <AssemblyVersion>$(AppNumericVersion)</AssemblyVersion>
    <FileVersion>$(AppNumericVersion)</FileVersion>
    <InformationalVersion>$(AppVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Steam LZX Tray</Product>
    <Company>Brandon</Company>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>embedded</DebugType>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningLevel>5</WarningLevel>
    <AnalysisLevel>latest</AnalysisLevel>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
